# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server-side only). Used for file storage and by the seed.
SUPABASE_SECRET_KEY=

# Supabase pooler, transaction mode, port 6543 (server-side only).
# Percent-encode special characters in the password (# becomes %23), or the
# value is cut off at that character.
DATABASE_URL=

# Password given to the fictional accounts that `npm run db:seed` creates
SEED_USER_PASSWORD=

# Local PostgreSQL 18 test database (server-side only)
TEST_DATABASE_URL=
