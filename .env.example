# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server-side only). Used for file storage and by the seed.
SUPABASE_SECRET_KEY=

# Database password: do not paste or share it in chat or commits.
# The current password is stored in Infisical Cloud. Ask a teammate for access
# if you don't have it, then copy it into DATABASE_URL in .env.local and .env.
# Use the Supabase transaction pooler string (port 6543).
# Format: postgresql://postgres.<project-ref>:<PASSWORD>@<pooler-host>:6543/postgres
# Special characters in the password must be URL-encoded.
DATABASE_URL=

# Password given to the fictional accounts that `npm run db:seed` creates
SEED_USER_PASSWORD=

# Local PostgreSQL 18 test database (server-side only)
TEST_DATABASE_URL=
